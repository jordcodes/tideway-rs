// Handlers

async fn get_stats(
    Extension(state): Extension<AdminState>,
    headers: axum::http::HeaderMap,
) -> Result<Json<PlatformStats>> {
    let actor = RequestActor::from_headers_with_verifier(
        &headers,
        state.db.as_ref(),
        &state.jwt_verifier,
    )
    .await?;
    actor.require_admin()?;

    let total_users = user::Entity::find()
        .count(state.db.as_ref())
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?;

    {{#if has_organizations}}
    let total_organizations = organization::Entity::find()
        .count(state.db.as_ref())
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?;
    {{/if}}

    let thirty_days_ago = Utc::now() - Duration::days(30);
    let recent_signups = user::Entity::find()
        .filter(user::Column::CreatedAt.gte(thirty_days_ago))
        .count(state.db.as_ref())
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?;

    {{#if has_billing_feature}}
    let active_subscriptions = billing_subscription::Entity::find()
        .filter(billing_subscription::Column::Status.is_in([
            SubscriptionStatus::Active.as_str(),
            SubscriptionStatus::Trialing.as_str(),
        ]))
        .count(state.db.as_ref())
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?;

    let (mrr_cents, mrr_currency, mrr_unavailable_reason) = match monthly_recurring_revenue(state.db.as_ref()).await? {
        Ok(mrr) => (Some(mrr.cents), mrr.currency, None),
        Err(reason) => (None, None, Some(reason)),
    };
    {{/if}}

    Ok(Json(PlatformStats {
        total_users,
        {{#if has_organizations}}
        total_organizations,
        {{/if}}
        recent_signups,
        {{#if has_billing_feature}}
        active_subscriptions,
        mrr_cents,
        mrr_currency,
        mrr_unavailable_reason,
        {{/if}}
    }))
}

{{#if has_billing_feature}}
struct Mrr {
    cents: u64,
    currency: Option<String>,
}

#[derive(Debug, FromQueryResult)]
struct PlanSubscriptionTotals {
    plan_id: String,
    subscriptions: i64,
    extra_seats: Option<i64>,
}

/// Sums `billing_plans.price_cents` over subscriptions with status `active`, with yearly
/// plans divided by 12 and one-time plans excluded. Trials are not revenue yet, so they
/// are counted in `active_subscriptions` but not here.
///
/// The inner `Err` explains why the tables can't produce an accurate number: a subscription
/// on a plan missing from `billing_plans`, extra seats (seat prices are not stored), or plans
/// in more than one currency.
async fn monthly_recurring_revenue(
    db: &DatabaseConnection,
) -> Result<std::result::Result<Mrr, String>> {
    let totals = billing_subscription::Entity::find()
        .select_only()
        .column(billing_subscription::Column::PlanId)
        .column_as(billing_subscription::Column::BillableId.count(), "subscriptions")
        .column_as(billing_subscription::Column::ExtraSeats.sum(), "extra_seats")
        .filter(billing_subscription::Column::Status.eq(SubscriptionStatus::Active.as_str()))
        .group_by(billing_subscription::Column::PlanId)
        .into_model::<PlanSubscriptionTotals>()
        .all(db)
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?;

    let plans: HashMap<String, billing_plan::Model> = billing_plan::Entity::find()
        .filter(billing_plan::Column::Id.is_in(totals.iter().map(|t| t.plan_id.clone())))
        .all(db)
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?
        .into_iter()
        .map(|plan| (plan.id.clone(), plan))
        .collect();

    let mut monthly_cents: u64 = 0;
    let mut yearly_cents: u64 = 0;
    let mut currency: Option<String> = None;
    for total in &totals {
        let Some(plan) = plans.get(&total.plan_id) else {
            return Ok(Err(format!(
                "subscriptions reference plan `{}`, which is not in billing_plans",
                total.plan_id
            )));
        };
        if total.extra_seats.unwrap_or(0) > 0 {
            return Ok(Err(format!(
                "subscriptions on plan `{}` have extra seats, and seat prices are not stored in billing_plans",
                plan.id
            )));
        }
        match &currency {
            Some(existing) if !existing.eq_ignore_ascii_case(&plan.currency) => {
                return Ok(Err("active plans are priced in more than one currency".to_string()));
            }
            Some(_) => {}
            None => currency = Some(plan.currency.to_ascii_lowercase()),
        }

        let amount = u64::try_from(plan.price_cents).unwrap_or(0)
            * u64::try_from(total.subscriptions).unwrap_or(0);
        match PlanInterval::from_str(&plan.interval) {
            PlanInterval::Monthly => monthly_cents += amount,
            PlanInterval::Yearly => yearly_cents += amount,
            PlanInterval::OneTime => {}
        }
    }

    // Divide yearly revenue once, rounding to the nearest cent, rather than per subscription.
    let cents = monthly_cents + (yearly_cents + 6) / 12;
    Ok(Ok(Mrr { cents, currency }))
}
{{/if}}

async fn list_users(
    Extension(state): Extension<AdminState>,
    headers: axum::http::HeaderMap,
    Query(query): Query<ListUsersQuery>,
) -> Result<Json<PaginatedUsers>> {
    let actor = RequestActor::from_headers_with_verifier(
        &headers,
        state.db.as_ref(),
        &state.jwt_verifier,
    )
    .await?;
    actor.require_admin()?;

    let mut select = user::Entity::find();

    if let Some(search) = &query.search {
        select = select.filter(
            user::Column::Email.contains(search)
                .or(user::Column::Name.contains(search))
        );
    }

    select = select.order_by_desc(user::Column::CreatedAt);

    let per_page = query.per_page.clamp(1, 100);
    let page = query.page.max(1);

    let paginator = select.paginate(state.db.as_ref(), u64::from(per_page));
    let total = paginator.num_items().await
        .map_err(|e| TidewayError::Database(e.to_string()))?;

    let users = paginator.fetch_page(u64::from(page - 1)).await
        .map_err(|e| TidewayError::Database(e.to_string()))?;

    let items: Vec<AdminUserResponse> = users.into_iter().map(AdminUserResponse::from).collect();

    let total_pages = total.div_ceil(u64::from(per_page)) as u32;

    Ok(Json(PaginatedUsers {
        items,
        total,
        page,
        per_page,
        total_pages,
    }))
}

async fn get_user(
    Extension(state): Extension<AdminState>,
    headers: axum::http::HeaderMap,
    Path(user_id): Path<String>,
) -> Result<Json<AdminUserResponse>> {
    let actor = RequestActor::from_headers_with_verifier(
        &headers,
        state.db.as_ref(),
        &state.jwt_verifier,
    )
    .await?;
    actor.require_admin()?;

    let target_uuid = Uuid::parse_str(&user_id)
        .map_err(|_| TidewayError::BadRequest("Invalid user ID".into()))?;

    let user = user::Entity::find_by_id(target_uuid)
        .one(state.db.as_ref())
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?
        .ok_or_else(|| TidewayError::NotFound("User not found".into()))?;

    Ok(Json(AdminUserResponse::from(user)))
}

async fn update_user(
    Extension(state): Extension<AdminState>,
    headers: axum::http::HeaderMap,
    Path(user_id): Path<String>,
    Json(body): Json<UpdateUserBody>,
) -> Result<MessageResponse> {
    let actor = RequestActor::from_headers_with_verifier(
        &headers,
        state.db.as_ref(),
        &state.jwt_verifier,
    )
    .await?;
    actor.require_admin()?;

    let target_uuid = Uuid::parse_str(&user_id)
        .map_err(|_| TidewayError::BadRequest("Invalid user ID".into()))?;

    let user = user::Entity::find_by_id(target_uuid)
        .one(state.db.as_ref())
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?
        .ok_or_else(|| TidewayError::NotFound("User not found".into()))?;

    let mut active: user::ActiveModel = user.into();

    if let Some(name) = body.name {
        active.name = Set(Some(name));
    }

    if let Some(verified) = body.email_verified {
        if verified {
            active.email_verified_at = Set(Some(Utc::now().into()));
        } else {
            active.email_verified_at = Set(None);
        }
    }

    if let Some(locked) = body.locked {
        if locked {
            active.locked_until = Set(Some((Utc::now() + Duration::days(36500)).into()));
        } else {
            active.locked_until = Set(None);
        }
    }

    if let Some(is_admin) = body.is_platform_admin {
        active.is_platform_admin = Set(is_admin);
    }

    active.updated_at = Set(Utc::now().into());

    active
        .update(state.db.as_ref())
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?;

    Ok(MessageResponse::success("User updated"))
}

{{#if has_organizations}}
async fn list_organizations(
    Extension(state): Extension<AdminState>,
    headers: axum::http::HeaderMap,
    Query(query): Query<ListOrgsQuery>,
) -> Result<Json<PaginatedOrgs>> {
    let actor = RequestActor::from_headers_with_verifier(
        &headers,
        state.db.as_ref(),
        &state.jwt_verifier,
    )
    .await?;
    actor.require_admin()?;

    let mut select = organization::Entity::find();

    if let Some(search) = &query.search {
        select = select.filter(
            organization::Column::Name.contains(search)
                .or(organization::Column::Slug.contains(search))
        );
    }

    select = select.order_by_desc(organization::Column::CreatedAt);

    let per_page = query.per_page.clamp(1, 100);
    let page = query.page.max(1);

    let paginator = select.paginate(state.db.as_ref(), u64::from(per_page));
    let total = paginator.num_items().await
        .map_err(|e| TidewayError::Database(e.to_string()))?;

    let orgs = paginator.fetch_page(u64::from(page - 1)).await
        .map_err(|e| TidewayError::Database(e.to_string()))?;

    let org_ids: Vec<String> = orgs.iter().map(|o| o.id.clone()).collect();

    let member_counts = organization_member::Entity::find()
        .filter(organization_member::Column::OrganizationId.is_in(org_ids.clone()))
        .all(state.db.as_ref())
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?;

    let mut count_map: std::collections::HashMap<String, u64> = std::collections::HashMap::new();
    for m in member_counts {
        *count_map.entry(m.organization_id).or_insert(0) += 1;
    }

    {{#if has_billing_feature}}
    let mut status_map: HashMap<String, String> = billing_subscription::Entity::find()
        .filter(billing_subscription::Column::BillableId.is_in(org_ids))
        .all(state.db.as_ref())
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?
        .into_iter()
        .map(|s| (s.billable_id, s.status))
        .collect();
    {{/if}}

    let items: Vec<AdminOrgResponse> = orgs
        .into_iter()
        .map(|o| {
            let member_count = count_map.get(&o.id).copied();
            AdminOrgResponse {
                {{#if has_billing_feature}}
                subscription_status: status_map.remove(&o.id),
                {{/if}}
                id: o.id,
                name: o.name,
                slug: o.slug,
                owner_id: o.owner_id.to_string(),
                contact_email: Some(o.contact_email),
                member_count,
                created_at: o.created_at,
                updated_at: o.updated_at,
            }
        })
        .collect();

    let total_pages = total.div_ceil(u64::from(per_page)) as u32;

    Ok(Json(PaginatedOrgs {
        items,
        total,
        page,
        per_page,
        total_pages,
    }))
}

async fn get_organization(
    Extension(state): Extension<AdminState>,
    headers: axum::http::HeaderMap,
    Path(org_id): Path<String>,
) -> Result<Json<AdminOrgResponse>> {
    let actor = RequestActor::from_headers_with_verifier(
        &headers,
        state.db.as_ref(),
        &state.jwt_verifier,
    )
    .await?;
    actor.require_admin()?;

    let org = organization::Entity::find_by_id(&org_id)
        .one(state.db.as_ref())
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?
        .ok_or_else(|| TidewayError::NotFound("Organization not found".into()))?;

    let member_count = organization_member::Entity::find()
        .filter(organization_member::Column::OrganizationId.eq(&org_id))
        .count(state.db.as_ref())
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?;

    {{#if has_billing_feature}}
    let subscription_status = billing_subscription::Entity::find_by_id(&org_id)
        .one(state.db.as_ref())
        .await
        .map_err(|e| TidewayError::Database(e.to_string()))?
        .map(|s| s.status);
    {{/if}}

    Ok(Json(AdminOrgResponse {
        id: org.id,
        name: org.name,
        slug: org.slug,
        owner_id: org.owner_id.to_string(),
        contact_email: Some(org.contact_email),
        {{#if has_billing_feature}}
        subscription_status,
        {{/if}}
        member_count: Some(member_count),
        created_at: org.created_at,
        updated_at: org.updated_at,
    }))
}
{{/if}}

async fn start_impersonation(
    Extension(state): Extension<AdminState>,
    headers: axum::http::HeaderMap,
    Path(user_id): Path<String>,
    Json(mut body): Json<ImpersonationRequestBody>,
) -> Result<Json<ImpersonationResponse>> {
    let actor = RequestActor::from_headers_with_verifier(
        &headers,
        state.db.as_ref(),
        &state.jwt_verifier,
    )
    .await?;
    actor.require_admin()?;

    if body.target_user_id != user_id {
        return Err(TidewayError::BadRequest(
            "target_user_id does not match the user in the path".into(),
        ));
    }
    // A blank reason counts as no reason.
    body.reason = body.reason.filter(|reason| !reason.trim().is_empty());

    // Validates the reason, admin rights, admin targets, and concurrent
    // sessions, then stores the session and its audit entry.
    let session = state
        .impersonation
        .start_impersonation(body.into_request(actor.user.id.to_string()))
        .await?;

    let target_user = user::Entity::find_by_id(
        Uuid::parse_str(&session.target_user_id)
            .map_err(|_| TidewayError::BadRequest("Invalid user ID".into()))?,
    )
    .one(state.db.as_ref())
    .await
    .map_err(|e| TidewayError::Database(e.to_string()))?
    .ok_or_else(|| TidewayError::NotFound("User not found".into()))?;

    let subject = TokenSubject {
        user_id: &session.target_user_id,
        email: Some(&target_user.email),
        name: target_user.name.as_deref(),
        session_version: target_user.session_version.max(0) as u64,
        custom: Some(ImpersonationClaims::from_session(&session)),
    };
    let access_token = match state
        .jwt_issuer
        .issue_access_token_expiring_at(subject, session.expires_at)
    {
        Ok((token, _)) => token,
        Err(error) => {
            // Don't leave a live session behind without a token.
            let _ = state
                .impersonation
                .end_impersonation(&session.session_id)
                .await;
            return Err(TidewayError::Internal(format!(
                "Failed to issue token: {}",
                error
            )));
        }
    };

    Ok(Json(ImpersonationResponse {
        session_id: session.session_id,
        target_user_id: session.target_user_id,
        target_user_email: target_user.email,
        access_token,
        expires_at: i64::try_from(session.expires_at).unwrap_or(i64::MAX),
    }))
}

/// Ends the impersonation session of the calling impersonation token. The
/// token stops working immediately.
async fn end_impersonation(
    Extension(state): Extension<AdminState>,
    headers: axum::http::HeaderMap,
) -> Result<MessageResponse> {
    let actor = RequestActor::from_headers_with_verifier(
        &headers,
        state.db.as_ref(),
        &state.jwt_verifier,
    )
    .await?;
    let claims = actor
        .impersonation
        .ok_or_else(|| TidewayError::BadRequest("Not an impersonation session".into()))?;

    state
        .impersonation
        .end_impersonation(&claims.imp_session)
        .await?;

    Ok(MessageResponse::success("Impersonation ended"))
}
