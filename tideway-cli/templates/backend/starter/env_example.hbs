# Server
TIDEWAY_HOST=0.0.0.0
TIDEWAY_PORT=8000

{{#if has_database_feature}}
# Database
DATABASE_URL={{{database_url}}}

{{/if}}
{{#if has_auth_feature}}
# Auth
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER={{project_crate}}
JWT_AUDIENCE={{project_crate}}
{{#if has_database_feature}}
# Disabled by default for private and invitation-only products.
ALLOW_PUBLIC_REGISTRATION=false
{{/if}}
{{#if has_auth_mfa_feature}}
# Generate independently from JWT_SECRET with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
{{/if}}
# Comma-separated proxy IPs/CIDRs. Leave empty unless traffic arrives through them.
TRUSTED_PROXY_IPS=
# General per-IP safety net; auth endpoints also have stricter dedicated limits.
TIDEWAY_RATE_LIMIT_ENABLED=true
TIDEWAY_RATE_LIMIT_MAX_REQUESTS=300
TIDEWAY_RATE_LIMIT_WINDOW_SECONDS=60
TIDEWAY_RATE_LIMIT_STRATEGY=per_ip
# Keep this equal to TRUSTED_PROXY_IPS when a trusted proxy is configured.
TIDEWAY_RATE_LIMIT_TRUSTED_PROXIES=
REFRESH_TOKEN_RETENTION_DAYS=120
{{#if has_database_feature}}
# Requires email delivery (EMAIL_PROVIDER below).
REQUIRE_EMAIL_VERIFICATION=false

# Environment: console email is only allowed in development.
TIDEWAY_ENV=development
# Frontend URL used for verification and password-reset links (https outside development).
APP_URL=http://localhost:5173
APP_NAME={{project_name_pascal}}

# Email: console, resend, or smtp. Unset to disable verification and password-reset routes.
EMAIL_PROVIDER=console
EMAIL_FROM="{{project_name}} <noreply@example.com>"
# true prints full emails, including one-time links. Trusted development machines only.
EMAIL_CONSOLE_SHOW_BODY=false
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Required when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Background workers that deliver queued emails.
TIDEWAY_JOBS_WORKER_COUNT=2
TIDEWAY_JOBS_MAX_RETRIES=3
TIDEWAY_JOBS_RETRY_BACKOFF_SECONDS=60
{{else}}
REQUIRE_EMAIL_VERIFICATION=false
{{/if}}

{{/if}}
{{#if has_openapi_feature}}
# OpenAPI
OPENAPI_ENABLED=true
OPENAPI_SWAGGER_UI=true
OPENAPI_SERVE_SPEC=true

{{/if}}
