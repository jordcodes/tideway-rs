//! {{project_name_pascal}} API server.

{{#if has_config}}
use tideway::{init_tracing_with_config, App};
use crate::config::AppConfig;
{{else}}
use tideway::{init_tracing, App};
{{/if}}
{{#if has_database_feature}}
use std::sync::Arc;
{{/if}}
{{#if has_database_feature}}
use tideway::{AppContext, SeaOrmPool};
{{/if}}
{{#if has_auth_feature}}
use axum::Extension;
use crate::auth::{AuthModule, SimpleAuthProvider};
use tideway::auth::{AccessTokenClaims, JwtAuth, JwtAuthConfig};
{{#if has_database_feature}}
use std::time::Duration;
use tideway::jobs::JobsConfig;
use tideway::{InMemoryJobQueue, JobQueue, JobRegistry, WorkerPool};
use crate::email::EmailSetup;
{{/if}}
{{/if}}

mod routes;
{{#if has_openapi_feature}}
mod openapi_docs;
{{/if}}
{{#if has_auth_feature}}
mod auth;
{{#if has_database_feature}}
mod email;
{{/if}}
{{/if}}
{{#if has_database_feature}}
mod entities;
{{/if}}
{{#if has_config}}
mod config;
mod error;
{{/if}}

#[tokio::main]
async fn main() -> Result<(), std::io::Error> {
{{#if has_config}}
    let config = AppConfig::from_env();
    init_tracing_with_config(&config.tideway);
{{else}}
    init_tracing();
    {{#if has_openapi_feature}}
    let config = tideway::ConfigBuilder::new()
        .from_env()
        .build()
        .expect("Invalid TIDEWAY_* config");
    {{/if}}
{{/if}}

{{#if has_database_feature}}
    {{#if has_config}}
    let database_url = config
        .database_url
        .clone()
        .expect("DATABASE_URL is not set");
    {{else}}
    let database_url = std::env::var("DATABASE_URL").expect("DATABASE_URL is not set");
    {{/if}}
    let db = sea_orm::Database::connect(&database_url)
        .await
        .expect("Failed to connect to database");
{{/if}}

{{#if has_auth_feature}}
    {{#if has_config}}
    let jwt_secret = config
        .jwt_secret
        .clone()
        .expect("JWT_SECRET is not set");
    let jwt_issuer_id = config.jwt_issuer.clone();
    let jwt_audience = config.jwt_audience.clone();
    {{#if has_database_feature}}
    let allow_public_registration = config.allow_public_registration;
    {{/if}}
    {{else}}
    let jwt_secret = std::env::var("JWT_SECRET").expect("JWT_SECRET is not set");
    let jwt_issuer_id = std::env::var("JWT_ISSUER")
        .unwrap_or_else(|_| env!("CARGO_PKG_NAME").to_string());
    let jwt_audience = std::env::var("JWT_AUDIENCE")
        .unwrap_or_else(|_| env!("CARGO_PKG_NAME").to_string());
    {{#if has_database_feature}}
    let allow_public_registration = std::env::var("ALLOW_PUBLIC_REGISTRATION")
        .is_ok_and(|value| value.eq_ignore_ascii_case("true"));
    {{/if}}
    {{/if}}
    let jwt = JwtAuth::new(
        JwtAuthConfig::with_secure_secret(&jwt_secret, jwt_issuer_id)
            .expect("JWT_SECRET must be at least 32 bytes")
            .audience(jwt_audience),
    )
    .expect("Failed to create paired JWT authentication");
    let jwt_verifier = jwt
        .verifier::<AccessTokenClaims<serde_json::Value>>()
        .expect("Failed to create JWT verifier");
    {{#if has_database_feature}}
    let jwt_issuer = jwt.issuer();
    let auth_db = Arc::new(db.clone());
    let auth_provider = SimpleAuthProvider::new(jwt_verifier, auth_db.clone());

    // Lifecycle emails (verification, password reset) are queued by request handlers and
    // delivered by background workers. Swap in `tideway::RedisJobQueue` (feature `jobs-redis`)
    // when queued emails must survive restarts.
    let jobs_config = JobsConfig::from_env();
    let job_queue: Arc<dyn JobQueue> = Arc::new(InMemoryJobQueue::new(
        jobs_config.max_retries,
        jobs_config.retry_backoff_seconds,
    ));
    let email = EmailSetup::from_env(job_queue.clone()).expect("Invalid email configuration");
    let auth_module = AuthModule::new(
        auth_db,
        jwt_issuer.clone(),
        jwt_secret,
        "{{project_name}}",
    )
    .with_public_registration(allow_public_registration);
    let auth_module = match &email {
        Some(email) => auth_module.with_email_delivery(email.emails.clone()),
        None => {
            tracing::warn!(
                "EMAIL_PROVIDER is not set; email verification and password reset routes are disabled"
            );
            auth_module
        }
    };
    {{else}}
    let auth_provider = SimpleAuthProvider::new(jwt_verifier);
    let auth_module = AuthModule::new();
    {{/if}}
{{/if}}

{{#if has_config}}
    // tideway:app-builder:start
    let app = App::with_config(config.tideway.clone())
{{else}}
    // tideway:app-builder:start
    let app = App::new()
{{/if}}
{{#if has_auth_feature}}
        .with_global_layer(Extension(auth_provider))
        .register_module(auth_module)
{{/if}}
{{#if has_database_feature}}
        .with_context(
            AppContext::builder()
                .with_database(Arc::new(SeaOrmPool::new(db, database_url)))
{{#if has_auth_feature}}
                .with_job_queue(job_queue.clone())
{{/if}}
                .build()
        )
{{/if}}
        .register_module(routes::ApiModule);
    // tideway:app-builder:end

{{#if has_database_feature}}
    let app = app
        .run_migrations::<migration::Migrator>()
        .await
        .expect("Failed to run database migrations");

{{/if}}
{{#if has_openapi_feature}}
    let app = if {{#if has_config}}config.tideway{{else}}config{{/if}}.openapi.enabled {
        let openapi = {{#if has_auth_feature}}{{#if has_database_feature}}tideway::openapi::merge_openapi(vec![
            <openapi_docs::ApiDoc as utoipa::OpenApi>::openapi(),
            auth::auth_openapi(allow_public_registration),
        ]){{else}}tideway::openapi_merge_module!(openapi_docs, ApiDoc){{/if}}{{else}}tideway::openapi_merge_module!(openapi_docs, ApiDoc){{/if}};
        let openapi_router = tideway::openapi::create_openapi_router(
            openapi,
            &{{#if has_config}}config.tideway{{else}}config{{/if}}.openapi,
        );
        app.merge_router(openapi_router)
    } else {
        app
    };
{{/if}}

{{#if has_auth_feature}}
{{#if has_database_feature}}
    let email_workers = match email {
        Some(email) => {
            let registry = Arc::new(JobRegistry::new());
            tideway::email::register_email_jobs(&registry).await;
            let worker_context = AppContext::builder()
                .with_mailer(email.mailer)
                .with_job_queue(job_queue.clone())
                .build();
            Some(WorkerPool::new(
                job_queue,
                registry,
                Arc::new(worker_context),
                jobs_config.worker_count.max(1),
            ))
        }
        None => None,
    };

    let result = app.serve().await;
    if let Some(workers) = email_workers {
        workers
            .shutdown_with_timeout(Duration::from_secs(jobs_config.shutdown_timeout_seconds))
            .await;
    }
    result
{{else}}
    app.serve().await
{{/if}}
{{else}}
    app.serve().await
{{/if}}
}
