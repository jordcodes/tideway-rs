async fn request(
    app: &TestApp,
    method: Method,
    path: &str,
    body: Value,
    token: &str,
) -> (StatusCode, Value) {
    let request = Request::builder()
        .method(method)
        .uri(path)
        .header(header::CONTENT_TYPE, "application/json")
        .header(header::AUTHORIZATION, format!("Bearer {token}"))
        .body(Body::from(body.to_string()))
        .expect("build request");
    let response = app
        .router
        .clone()
        .oneshot(request)
        .await
        .expect("route response");
    let status = response.status();
    let bytes = to_bytes(response.into_body(), 1024 * 1024)
        .await
        .expect("read response body");
    (status, serde_json::from_slice(&bytes).unwrap_or(Value::Null))
}

async fn start(app: &TestApp, admin_token: &str, target_id: &str, body: Value) -> (StatusCode, Value) {
    request(
        app,
        Method::POST,
        &format!("/admin/users/{target_id}/impersonate"),
        body,
        admin_token,
    )
    .await
}

async fn audit_events(app: &TestApp, user_id: &str) -> Vec<ImpersonationEvent> {
    DbImpersonationStore::new(app.db.as_ref().clone())
        .get_audit_log(user_id, 100)
        .await
        .expect("read audit log")
        .into_iter()
        .map(|entry| entry.event)
        .collect()
}

#[tokio::test]
async fn impersonating_an_admin_is_rejected() {
    let app = test_app().await;
    let admin_token = app.token.clone();
    let other_admin_id = insert_user(&app.db, "other-admin@example.com", true)
        .await
        .id
        .to_string();

    let (status, body) = start(
        &app,
        &admin_token,
        &other_admin_id,
        json!({"target_user_id": other_admin_id, "reason": "SUP-1"}),
    )
    .await;
    assert_eq!(status, StatusCode::FORBIDDEN, "response: {body}");
    assert!(audit_events(&app, &other_admin_id).await.is_empty());
}

#[tokio::test]
async fn impersonation_requires_a_reason_and_an_admin() {
    let app = test_app().await;
    let admin_token = app.token.clone();
    let target = insert_user(&app.db, "user@example.com", false).await;
    let target_token = issue_token(&app.issuer, &target);
    let target_id = target.id.to_string();

    for body in [
        json!({"target_user_id": target_id}),
        json!({"target_user_id": target_id, "reason": "   "}),
    ] {
        let (status, response) = start(&app, &admin_token, &target_id, body).await;
        assert_eq!(status, StatusCode::BAD_REQUEST, "response: {response}");
    }

    // The acting admin always comes from the authenticated token.
    let (status, _) = start(
        &app,
        &admin_token,
        &target_id,
        json!({"target_user_id": target_id, "reason": "SUP-1", "admin_id": target_id}),
    )
    .await;
    assert!(status.is_client_error());

    let (status, _) = start(
        &app,
        &target_token,
        &target_id,
        json!({"target_user_id": target_id, "reason": "SUP-1"}),
    )
    .await;
    assert_eq!(status, StatusCode::FORBIDDEN);
    assert!(audit_events(&app, &target_id).await.is_empty());
}

#[tokio::test]
async fn impersonation_token_works_until_ended() {
    let app = test_app().await;
    let admin_id = app.admin.id.to_string();
    let admin_token = app.token.clone();
    let target_id = insert_user(&app.db, "user@example.com", false)
        .await
        .id
        .to_string();

    let (status, started) = start(
        &app,
        &admin_token,
        &target_id,
        json!({"target_user_id": target_id, "reason": "SUP-1234"}),
    )
    .await;
    assert_eq!(status, StatusCode::OK, "response: {started}");
    assert!(started.get("refresh_token").is_none(), "no refresh token: {started}");
    let token = started["access_token"].as_str().expect("access token").to_owned();
    let expires_at = started["expires_at"].as_i64().expect("expires_at");
    assert!(expires_at <= Utc::now().timestamp() + 60 * 60);

    let (status, me) = request(&app, Method::GET, "/whoami", Value::Null, &token).await;
    assert_eq!(status, StatusCode::OK, "response: {me}");
    assert_eq!(me["user_id"], target_id.as_str());
    assert_eq!(me["impersonated_by"], admin_id.as_str());

    // Impersonation tokens cannot reach admin routes.
    let (status, _) = request(&app, Method::GET, "/admin/stats", Value::Null, &token).await;
    assert_eq!(status, StatusCode::FORBIDDEN);

    let (status, response) =
        request(&app, Method::POST, "/admin/impersonation/end", json!({}), &token).await;
    assert_eq!(status, StatusCode::OK, "response: {response}");

    let (status, _) = request(&app, Method::GET, "/whoami", Value::Null, &token).await;
    assert_eq!(status, StatusCode::UNAUTHORIZED);
    let (status, _) =
        request(&app, Method::POST, "/admin/impersonation/end", json!({}), &token).await;
    assert_eq!(status, StatusCode::UNAUTHORIZED);

    // The admin's own token is unaffected and can't end anything.
    let (status, _) =
        request(&app, Method::POST, "/admin/impersonation/end", json!({}), &admin_token).await;
    assert_eq!(status, StatusCode::BAD_REQUEST);

    let mut events = audit_events(&app, &target_id).await;
    events.sort_by_key(|event| format!("{event:?}"));
    assert_eq!(events, vec![ImpersonationEvent::Ended, ImpersonationEvent::Started]);
}

#[tokio::test]
async fn impersonation_token_expires_after_max_duration() {
    let config = ImpersonationConfig::default().max_duration(Duration::from_secs(2));
    let app = test_app_with(config).await;
    let admin_token = app.token.clone();
    let target_id = insert_user(&app.db, "user@example.com", false)
        .await
        .id
        .to_string();

    let (status, started) = start(
        &app,
        &admin_token,
        &target_id,
        json!({"target_user_id": target_id, "reason": "SUP-1234", "duration_secs": 3600}),
    )
    .await;
    assert_eq!(status, StatusCode::OK, "response: {started}");
    let token = started["access_token"].as_str().expect("access token").to_owned();
    assert!(started["expires_at"].as_i64().expect("expires_at") <= Utc::now().timestamp() + 2);

    let (status, _) = request(&app, Method::GET, "/whoami", Value::Null, &token).await;
    assert_eq!(status, StatusCode::OK);

    tokio::time::sleep(Duration::from_millis(2_100)).await;

    let (status, _) = request(&app, Method::GET, "/whoami", Value::Null, &token).await;
    assert_eq!(status, StatusCode::UNAUTHORIZED);
    assert!(audit_events(&app, &target_id)
        .await
        .contains(&ImpersonationEvent::Expired));
}

