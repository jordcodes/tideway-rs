const JWT_SECRET: &str = "test-only-secret-with-at-least-32-bytes";
const JWT_ISSUER: &str = env!("CARGO_PKG_NAME");

async fn connect_test_database() -> DatabaseConnection {
    let Ok(database_url) = std::env::var("TEST_DATABASE_URL") else {
        return Database::connect("sqlite::memory:")
            .await
            .expect("connect to in-memory sqlite");
    };
    let schema = format!("test_{}", Uuid::new_v4().simple());
    let admin = Database::connect(&database_url)
        .await
        .expect("connect to PostgreSQL test database");
    admin
        .execute(Statement::from_string(
            DatabaseBackend::Postgres,
            format!("CREATE SCHEMA \"{schema}\""),
        ))
        .await
        .expect("create isolated PostgreSQL test schema");
    let mut options = ConnectOptions::new(database_url);
    options.set_schema_search_path(schema);
    Database::connect(options)
        .await
        .expect("connect to isolated PostgreSQL test schema")
}

struct TestApp {
    router: Router,
    db: Arc<DatabaseConnection>,
    issuer: Arc<JwtIssuer>,
    admin: user::Model,
    token: String,
}

async fn test_app() -> TestApp {
    test_app_with(ImpersonationConfig::default()).await
}

async fn test_app_with(impersonation: ImpersonationConfig) -> TestApp {
    let db = connect_test_database().await;
    Migrator::up(&db, None).await.expect("run migrations");
    let db = Arc::new(db);
    let jwt = JwtAuth::new(
        JwtAuthConfig::with_secure_secret(JWT_SECRET, JWT_ISSUER)
            .expect("valid secret")
            .audience(JWT_ISSUER),
    )
    .expect("create paired auth");
    let issuer = jwt.issuer();
    let verifier = jwt.verifier::<AccessTokenClaims>().expect("create verifier");

    let admin = insert_user(&db, "admin@example.com", true).await;
    let token = issue_token(&issuer, &admin);

    let admin_module = AdminModule::new(db.clone(), verifier.clone(), issuer.clone())
        .with_impersonation_config(impersonation);
    // Any route authenticated through `RequestActor`, to observe impersonation tokens.
    let whoami: Router = Router::new()
        .route("/whoami", get_route(whoami))
        .route("/whoami/billing", get_route(whoami_billing))
        .route("/whoami/durable", get_route(whoami_durable))
        .with_state((db.clone(), verifier));
    let router = App::new()
        .register_module(admin_module)
        .into_router()
        .merge(whoami);

    TestApp { router, db, issuer, admin, token }
}

fn issue_token(issuer: &JwtIssuer, user: &user::Model) -> String {
    issuer
        .issue(
            TokenSubject {
                user_id: &user.id.to_string(),
                email: Some(&user.email),
                name: None,
                session_version: 0,
                custom: None::<()>,
            },
            false,
        )
        .expect("issue token")
        .access_token
}

async fn whoami(
    State((db, verifier)): State<(Arc<DatabaseConnection>, JwtVerifier<AccessTokenClaims>)>,
    headers: HeaderMap,
) -> tideway::Result<Json<Value>> {
    let actor = RequestActor::from_headers_with_verifier(&headers, &db, &verifier).await?;
    Ok(Json(json!({
        "user_id": actor.user.id.to_string(),
        "impersonated_by": actor.impersonation.map(|claims| claims.imp_admin),
    })))
}

/// Stands in for a billing route: checks the `modify_billing` blocked action.
async fn whoami_billing(
    State((db, verifier)): State<(Arc<DatabaseConnection>, JwtVerifier<AccessTokenClaims>)>,
    headers: HeaderMap,
) -> tideway::Result<Json<Value>> {
    let actor = RequestActor::from_headers_with_verifier(&headers, &db, &verifier).await?;
    actor.require_action_allowed(&db, "modify_billing").await?;
    Ok(Json(json!({ "user_id": actor.user.id.to_string() })))
}

/// Stands in for API-key and invitation routes, which mint durable access.
async fn whoami_durable(
    State((db, verifier)): State<(Arc<DatabaseConnection>, JwtVerifier<AccessTokenClaims>)>,
    headers: HeaderMap,
) -> tideway::Result<Json<Value>> {
    let actor = RequestActor::from_headers_with_verifier(&headers, &db, &verifier).await?;
    actor.require_not_impersonating()?;
    Ok(Json(json!({ "user_id": actor.user.id.to_string() })))
}

async fn insert_user(db: &DatabaseConnection, email: &str, is_platform_admin: bool) -> user::Model {
    let now = Utc::now();
    user::ActiveModel {
        id: Set(Uuid::new_v4()),
        email: Set(email.to_string()),
        password_hash: Set("test-hash".to_string()),
        name: Set(None),
        {{#if has_organizations}}
        organization_id: Set(None),
        {{/if}}
        email_verified_at: Set(Some(now.into())),
        locked_until: Set(None),
        failed_attempts: Set(0),
        failed_mfa_attempts: Set(0),
        {{#if has_auth_mfa_feature}}
        mfa_enabled: Set(false),
        mfa_totp_secret_encrypted: Set(None),
        {{/if}}
        session_version: Set(0),
        is_platform_admin: Set(is_platform_admin),
        created_at: Set(now.into()),
        updated_at: Set(now.into()),
    }
    .insert(db)
    .await
    .expect("insert user")
}

