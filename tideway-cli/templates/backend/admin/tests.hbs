    let (status, started) = start(
        app,
        admin_token,
        target_id,
        json!({"target_user_id": target_id, "reason": "SUP-1234"}),
    )
    .await;
    assert_eq!(status, StatusCode::OK, "response: {started}");
    started["access_token"].as_str().expect("access token").to_owned()
}

#[tokio::test]
async fn impersonation_enforces_configured_blocked_actions() {
    let config = ImpersonationConfig::default().blocked_actions(vec![BlockedAction::ModifyBilling]);
    let app = test_app_with(config).await;
    let admin_token = app.token.clone();
    let target = insert_user(&app.db, "user@example.com", false).await;
    let target_id = target.id.to_string();
    let token = start_token(&app, &admin_token, &target_id).await;

    let (status, _) = request(&app, Method::GET, "/whoami/billing", Value::Null, &token).await;
    assert_eq!(status, StatusCode::FORBIDDEN);
    assert!(audit_events(&app, &target_id)
        .await
        .contains(&ImpersonationEvent::BlockedAttempt));

    // The target's own token is not affected.
    let own_token = issue_token(&app.issuer, &target);
    let (status, _) = request(&app, Method::GET, "/whoami/billing", Value::Null, &own_token).await;
    assert_eq!(status, StatusCode::OK);
}

#[tokio::test]
async fn impersonation_tokens_cannot_mint_durable_access() {
    let app = test_app().await;
    let admin_token = app.token.clone();
    let target = insert_user(&app.db, "user@example.com", false).await;
    let token = start_token(&app, &admin_token, &target.id.to_string()).await;

    let (status, _) = request(&app, Method::GET, "/whoami/durable", Value::Null, &token).await;
    assert_eq!(status, StatusCode::FORBIDDEN);
    let own_token = issue_token(&app.issuer, &target);
    let (status, _) = request(&app, Method::GET, "/whoami/durable", Value::Null, &own_token).await;
    assert_eq!(status, StatusCode::OK);
}

#[tokio::test]
async fn locking_an_admin_ends_their_impersonation_sessions() {
    let app = test_app().await;
    let support = insert_user(&app.db, "support@example.com", true).await;
    let support_token = issue_token(&app.issuer, &support);
    let target_id = insert_user(&app.db, "user@example.com", false)
        .await
        .id
        .to_string();
    let token = start_token(&app, &support_token, &target_id).await;
    let (status, _) = request(&app, Method::GET, "/whoami", Value::Null, &token).await;
    assert_eq!(status, StatusCode::OK);

    let (status, response) = request(
        &app,
        Method::PATCH,
        &format!("/admin/users/{}", support.id),
        json!({"locked": true}),
        &app.token,
    )
    .await;
    assert_eq!(status, StatusCode::OK, "response: {response}");

    let (status, _) = request(&app, Method::GET, "/whoami", Value::Null, &token).await;
    assert_eq!(status, StatusCode::UNAUTHORIZED);
    assert!(audit_events(&app, &target_id)
        .await
        .contains(&ImpersonationEvent::Ended));
}
