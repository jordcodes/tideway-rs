/// Admin routes state.
#[derive(Clone)]
pub struct AdminState {
    pub db: Arc<DatabaseConnection>,
    pub jwt_verifier: JwtVerifier<AccessTokenClaims>,
    pub jwt_issuer: Arc<JwtIssuer>,
    pub impersonation: Arc<AppImpersonationManager>,
}

/// Admin routes module.
pub struct AdminModule {
    state: AdminState,
}

impl AdminModule {
    pub fn new(
        db: Arc<DatabaseConnection>,
        jwt_verifier: JwtVerifier<AccessTokenClaims>,
        jwt_issuer: Arc<JwtIssuer>,
    ) -> Self {
        let impersonation = Arc::new(impersonation_manager(
            db.as_ref().clone(),
            ImpersonationConfig::default(),
        ));
        Self {
            state: AdminState {
                db,
                jwt_verifier,
                jwt_issuer,
                impersonation,
            },
        }
    }

    /// Override the impersonation policy. The default requires a reason,
    /// blocks admin targets, and caps sessions at one hour.
    pub fn with_impersonation_config(mut self, config: ImpersonationConfig) -> Self {
        self.state.impersonation = Arc::new(impersonation_manager(
            self.state.db.as_ref().clone(),
            config,
        ));
        self
    }
}

impl RouteModule for AdminModule {
    fn routes(&self) -> Router<AppContext> {
        Router::new()
            .route("/stats", get(get_stats))
            .route("/users", get(list_users))
            .route("/users/{user_id}", get(get_user))
            .route("/users/{user_id}", patch(update_user))
            .route("/users/{user_id}/impersonate", post(start_impersonation))
            {{#if has_organizations}}
            .route("/organizations", get(list_organizations))
            .route("/organizations/{org_id}", get(get_organization))
            {{/if}}
            .route("/impersonation/end", post(end_impersonation))
            .layer(Extension(self.state.clone()))
    }

    fn prefix(&self) -> Option<&str> {
        Some("/admin")
    }
}

