    pub updated_at: i64,
}

impl From<user::Model> for AdminUserResponse {
    fn from(user: user::Model) -> Self {
        Self {
            id: user.id.to_string(),
            {{#if has_auth_mfa_feature}}
            // Matches `has_mfa_enabled` in the auth store: the flag alone is not enough
            // without an enrolled TOTP secret.
            mfa_enabled: user.mfa_enabled && user.mfa_totp_secret_encrypted.is_some(),
            {{else}}
            // Generated without the `auth-mfa` feature, so no user can have MFA enabled.
            mfa_enabled: false,
            {{/if}}
            email: user.email,
            name: user.name,
            email_verified: user.email_verified_at.is_some(),
            locked: user.locked_until.map(|t| t > Utc::now()).unwrap_or(false),
            is_platform_admin: user.is_platform_admin,
            created_at: user.created_at.timestamp(),
            updated_at: user.updated_at.timestamp(),
        }
    }
}

